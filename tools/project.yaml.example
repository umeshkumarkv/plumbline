# .plumbline/project.yaml — only needed when auto-detection (python3 .plumbline/impact/layout.py .) gets the
# units wrong. Rename to project.yaml. A human edits this file (it is a protected path; agents cannot change it).
units:
  - {name: shop, path: ., kind: service}        # a Spring app at the repository root (code in ./src)
  - {name: ui,   path: ui, kind: frontend}       # a React app in ui/
#  - {name: billing, path: modules/billing, kind: service}

# Domain rule pack the judge applies (business rules of THIS domain). `none` for a repo without one.
# Without project.yaml the broker-dealer pack (.plumbline/packs/domain-rules/rules.yaml) is used.
domain_pack: none
