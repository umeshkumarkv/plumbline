# Copy to the OMS repo as security/tool-versions.env and fill with the versions your security team approved.
# Changes to this file go through PR review like any dependency bump.
VERACODE_PIPELINE_SCAN_URL=https://<approved-mirror>/pipeline-scan-<version>.zip
VERACODE_PIPELINE_SCAN_SHA256=<sha256 of that exact file>
DETECT_JAR_URL=https://<approved-mirror>/synopsys-detect-<version>.jar
DETECT_JAR_SHA256=<sha256 of that exact file>
