{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Task",
      "Agent",
      "Edit(.plumbline-drafts/**)",
      "Write(.plumbline-drafts/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git merge-base:*)",
      "Bash(git fetch:*)",
      "Bash(git switch -c:*)",
      "Bash(curl -s -o /dev/null:*)",
      "Bash(./mvnw test:*)",
      "Bash(mvn test:*)",
      "Bash(mvn -B test:*)",
      "Bash(npm test:*)",
      "Bash(npx ng test:*)",
      "Bash(java -version)",
      "Bash(node -v)",
      "Bash(mvn -v)",
      "Bash(./mvnw -v)"
    ],
    "deny": [
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(rm -rf:*)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --delete:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git -C:*)",
      "Read(**/*-prod*.properties)",
      "Read(**/*-prod*.yml)",
      "Read(**/*-prod*.yaml)",
      "Read(**/*-local*.properties)",
      "Read(**/*-local*.yml)",
      "Read(**/*-local*.yaml)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  }
}
