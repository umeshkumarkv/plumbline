+package com.brokerdealer.executionservice.service;
+
+import com.brokerdealer.executionservice.domain.OrderType;
+import com.brokerdealer.executionservice.dto.request.OrderExecutionRequest;
+import com.brokerdealer.executionservice.repository.ExecutionRepository;
+import com.brokerdealer.executionservice.repository.OrderStatusLookupRepository;
+import com.brokerdealer.executionservice.repository.PendingOrderExecutionRepository;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class ExecutionServiceStatusGuardTest {
+
+    @Mock private ExecutionRepository executionRepository;
+    @Mock private PendingOrderExecutionRepository pendingRepository;
+    @Mock private FillSimulationService fillSimulationService;
+    @Mock private OrderStatusLookupRepository orderStatusLookupRepository;
+    @InjectMocks private ExecutionService executionService;
+
+    @Test
+    void shouldNotFillOrderThatIsNotSentToExecution() {
+        OrderExecutionRequest request = new OrderExecutionRequest();
+        request.setOrderId(UUID.randomUUID());
+        request.setOrderType(OrderType.MARKET);
+        when(orderStatusLookupRepository.findStatus(request.getOrderId())).thenReturn(Optional.of("ACCEPTED"));
+
+        executionService.processFill(request);
+
+        verify(fillSimulationService, never()).executeMarketFill(any());
+    }
+}
