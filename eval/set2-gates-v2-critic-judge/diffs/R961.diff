+    public UserStatusResponse resetPassword(UUID targetId, UUID callerAdminId,
+                                            com.brokerdealer.authservice.dto.request.ResetPasswordRequest request) {
+        log.info("Admin password reset: targetId={} callerAdminId={} request={}", targetId, callerAdminId, request);
+
+        User user = userRepository.findById(targetId)
+                .orElseThrow(() -> new UserNotFoundException("USER_NOT_FOUND", "User not found: " + targetId));
+
+        user.setPasswordHash(passwordEncoder.encode(request.getNewPassword()));
+        user.setUpdatedAt(Instant.now());
+        User saved = userRepository.save(user);
+
+        log.info("Password reset completed: userId={}", saved.getId());
+        return UserStatusResponse.builder()
+                .userId(saved.getId())
+                .status(saved.getStatus().name())
+                .updatedAt(saved.getUpdatedAt())
+                .build();
+    }
