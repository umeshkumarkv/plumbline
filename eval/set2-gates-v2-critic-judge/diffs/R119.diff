+package com.brokerdealer.orderservice.service;
+
+import com.brokerdealer.orderservice.domain.OrderStatus;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class OrderStateTransitionTableTest {
+
+    @Test
+    void shouldAllowHappyPath() {
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.NEW, OrderStatus.VALIDATED)).isTrue();
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.ACCEPTED, OrderStatus.SENT_TO_EXECUTION)).isTrue();
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.SENT_TO_EXECUTION, OrderStatus.FILLED)).isTrue();
+    }
+
+    @Test
+    void shouldRejectTransitionsOutOfTerminalStates() {
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.FILLED, OrderStatus.NEW)).isFalse();
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.EXPIRED, OrderStatus.FILLED)).isFalse();
+        assertThat(OrderStateMachineService.isAllowedTransition(OrderStatus.RISK_REJECTED, OrderStatus.VALIDATED)).isFalse();
+    }
+}
