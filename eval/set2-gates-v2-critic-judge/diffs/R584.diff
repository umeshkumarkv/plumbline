+    public HoldingDetailResponse getHolding(UUID clientId, String symbol) {
+        log.debug("Fetching holding: clientId={} symbol={}", clientId, symbol);
+        if (symbol == null || !symbol.toUpperCase().matches("[A-Z]{1,6}")) {
+            throw new ValidationException("INVALID_SYMBOL", "symbol must be 1-6 letters A-Z");
+        }
+        if (!clientRepository.existsById(clientId)) {
+            throw new ClientNotFoundException("CLIENT_NOT_FOUND", "Client not found: " + clientId);
+        }
+        Holding holding = holdingRepository.findByClientIdAndSymbol(clientId, symbol.toUpperCase())
+                .orElseThrow();
+        return buildHoldingDetail(holding);
+    }
