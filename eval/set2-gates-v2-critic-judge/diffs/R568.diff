+package com.brokerdealer.auditservice.repository;
+
+import com.brokerdealer.auditservice.dto.response.AuditLogResponse;
+import lombok.RequiredArgsConstructor;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.core.RowMapper;
+import org.springframework.stereotype.Repository;
+
+import java.sql.Timestamp;
+import java.util.List;
+
+@Repository
+@RequiredArgsConstructor
+public class AuditLogQueryRepository {
+
+    private static final String SELECT_BY_ENTITY_TYPE =
+            "SELECT id, entity_type, entity_id, previous_state, new_state, actor_id, actor_type, "
+                    + "event_timestamp, metadata FROM audit_schema.audit_logs "
+                    + "WHERE entity_type = '%s' ORDER BY event_timestamp DESC LIMIT %d OFFSET %d";
+
+    private static final String COUNT_BY_ENTITY_TYPE =
+            "SELECT COUNT(*) FROM audit_schema.audit_logs WHERE entity_type = ?";
+
+    private static final RowMapper<AuditLogResponse> ROW_MAPPER = (rs, rowNum) -> {
+        Timestamp ts = rs.getTimestamp("event_timestamp");
+        return AuditLogResponse.builder()
+                .id(rs.getString("id"))
+                .entityType(rs.getString("entity_type"))
+                .entityId(rs.getString("entity_id"))
+                .previousState(rs.getString("previous_state"))
+                .newState(rs.getString("new_state"))
+                .actorId(rs.getString("actor_id"))
+                .actorType(rs.getString("actor_type"))
+                .eventTimestamp(ts != null ? ts.toInstant().toString() : null)
+                .metadata(rs.getString("metadata"))
+                .build();
+    };
+
+    private final JdbcTemplate jdbcTemplate;
+
+    public List<AuditLogResponse> findByEntityType(String entityType, int limit, int offset) {
+        String sql = String.format(SELECT_BY_ENTITY_TYPE, entityType.toUpperCase(), limit, offset);
+        return jdbcTemplate.query(sql, ROW_MAPPER);
+    }
+
+    public long countByEntityType(String entityType) {
+        Long count = jdbcTemplate.queryForObject(COUNT_BY_ENTITY_TYPE, Long.class, entityType.toUpperCase());
+        return count != null ? count : 0L;
+    }
+}
