+package com.brokerdealer.executionservice.kafka.producer;
+
+import com.brokerdealer.executionservice.dto.event.ExecutionCompletedEvent;
+import org.springframework.stereotype.Component;
+
+/**
+ * Chooses the record key for execution.completed.
+ * Each execution record is its own event, so the execution id is used as the key to
+ * spread fills of very active orders evenly across partitions; downstream consumers
+ * are idempotent (CLAUDE.md §7).
+ */
+@Component
+public class ExecutionEventKeyStrategy {
+
+    public String resolveKey(ExecutionCompletedEvent event) {
+        if (event.getExecutionId() != null) {
+            return event.getExecutionId().toString();
+        }
+        return event.getOrderId().toString();
+    }
+}
