+    /**
+     * Records the time an order reached a lifecycle milestone so that
+     * risk and execution latency can be reported per order.
+     */
+    private void stampMilestone(Order order, OrderStatus to) {
+        LocalDateTime now = LocalDateTime.now();
+        switch (to) {
+            case RISK_CHECK_PASSED -> order.setRiskCheckedAt(now);
+            case SENT_TO_EXECUTION -> order.setSentToExecutionAt(now);
+            case FILLED, REJECTED, EXPIRED -> order.setCompletedAt(now);
+            default -> {
+                // no milestone for intermediate states
+            }
+        }
+    }
+
