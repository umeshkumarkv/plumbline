+package com.brokerdealer.marketdataservice.service;
+
+import com.brokerdealer.marketdataservice.exception.ValidationException;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+@ExtendWith(MockitoExtension.class)
+class UpcomingHolidaysTest {
+
+    @InjectMocks
+    private MarketDataService marketDataService;
+
+    @Test
+    void shouldRejectZeroLimit() {
+        assertThatThrownBy(() -> marketDataService.getUpcomingHolidays(0))
+                .isInstanceOf(ValidationException.class);
+    }
+
+    @Test
+    void shouldRejectLimitAboveMaximum() {
+        assertThatThrownBy(() -> marketDataService.getUpcomingHolidays(21))
+                .isInstanceOf(ValidationException.class);
+    }
+}
