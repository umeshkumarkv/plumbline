+        LocalDate today = LocalDate.now(ZoneId.of(timezone));
+        log.debug("Fetching upcoming holidays: from={} limit={}", today, limit);
+        return marketHolidayRepository.findAllByOrderByHolidayDateAsc().stream()
+                .filter(h -> !h.getHolidayDate().isBefore(today))
+                .limit(limit)
+                .map(marketHolidayMapper::toResponse)
+                .toList();
+    }
