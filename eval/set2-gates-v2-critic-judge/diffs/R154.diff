+    public ExecutionSummaryResponse getExecutionSummary(UUID orderId) {
+        List<Execution> executions = executionRepository.findByOrderIdOrderByExecutedAtAsc(orderId);
+        if (executions.isEmpty()) {
+            throw new ResourceNotFoundException("ORDER_NOT_FOUND",
+                    "No executions found for order: " + orderId);
+        }
+
+        List<Execution> fills = executions.stream()
+                .filter(e -> e.getFillType() != FillType.REJECTED)
+                .toList();
+        int filledQty = fills.stream().mapToInt(Execution::getExecutedQty).sum();
+        BigDecimal totalValue = fills.stream()
+                .map(Execution::getFillValue)
+                .reduce(BigDecimal.ZERO, BigDecimal::add)
+                .setScale(2, RoundingMode.HALF_UP);
+        BigDecimal avgPrice = filledQty == 0 ? null : fills.stream()
+                .map(e -> e.getExecutedPrice().multiply(BigDecimal.valueOf(e.getExecutedQty())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add)
+                .divide(BigDecimal.valueOf(filledQty), 4, RoundingMode.HALF_UP);
+        Execution last = executions.get(executions.size() - 1);
+
+        return ExecutionSummaryResponse.builder()
+                .data(ExecutionSummaryResponse.ExecutionSummaryData.builder()
+                        .orderId(orderId.toString())
+                        .fillCount(fills.size())
+                        .filledQuantity(filledQty)
+                        .remainingQuantity(last.getRemainingQuantity())
+                        .avgExecutedPrice(avgPrice)
+                        .totalFillValue(totalValue)
+                        .lastExecutedAt(last.getExecutedAt().toString())
+                        .build())
+                .meta(ResponseMeta.builder()
+                        .timestamp(Instant.now().toString())
+                        .requestId(UUID.randomUUID().toString())
+                        .build())
+                .build();
+    }
