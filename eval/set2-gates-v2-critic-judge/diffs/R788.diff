+    /**
+     * Clients whose KYC verification expires within the next {@code withinDays} days (ET),
+     * soonest first, capped at 100 rows. Used by operations to chase renewals before
+     * Level 2 check #4 starts rejecting the client's orders. When {@code includeExpired}
+     * is true, clients whose KYC has already lapsed are listed first.
+     */
+    public List<ClientProfileResponse> getKycExpiring(int withinDays, boolean includeExpired) {
+        if (withinDays < 1 || withinDays > 90) {
+            throw new ValidationException("VALIDATION_ERROR", "withinDays must be between 1 and 90");
+        }
+        java.time.LocalDate today = java.time.LocalDate.now(java.time.ZoneId.of("America/New_York"));
+        log.debug("Fetching KYC-expiring clients: withinDays={} includeExpired={}", withinDays, includeExpired);
+        List<Client> result = new java.util.ArrayList<>();
+        if (includeExpired) {
+            result.addAll(clientRepository.findByKycExpiryDateBeforeOrderByKycExpiryDateAsc(
+                    today, PageRequest.of(0, 100)));
+        }
+        int remaining = 100 - result.size();
+        if (remaining > 0) {
+            result.addAll(clientRepository.findByKycExpiryDateBetweenOrderByKycExpiryDateAsc(
+                    today, today.plusDays(withinDays), PageRequest.of(0, remaining)));
+        }
+        return result.stream()
+                .map(clientMapper::toProfileResponse)
+                .toList();
+    }
