@@ -0,0 +1,26 @@
+package com.brokerdealer.riskservice.domain;
+
+/**
+ * Severity assigned to a persisted WARN-action risk rule hit.
+ * Used by the operations dashboard to sort and colour warning rows.
+ */
+public enum WarningSeverity {
+    LOW,
+    MEDIUM,
+    HIGH;
+
+    /**
+     * Default severity for a WARN-action rule code. Fat-finger price and notional
+     * warnings are the most actionable; spike checks are informational.
+     */
+    public static WarningSeverity forRuleCode(String ruleCode) {
+        if (ruleCode == null) {
+            return LOW;
+        }
+        return switch (ruleCode) {
+            case "NOTIONAL_VALUE_CHECK", "PRICE_DEVIATION_CHECK" -> HIGH;
+            case "ORDER_QTY_SPIKE_CHECK", "ORDER_VALUE_SPIKE_CHECK" -> MEDIUM;
+            default -> LOW;
+        };
+    }
+}
