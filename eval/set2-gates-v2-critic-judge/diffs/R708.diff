+    /**
+     * Sets or clears the margin call flag consulted by order-service Level 2 check #14.
+     * Idempotent: an unchanged value is not re-saved.
+     */
+    @Transactional
+    public ClientProfileResponse updateMarginCall(UUID id, Boolean marginCallActive) {
+        log.debug("Updating margin call flag: clientId={}", id);
+        if (marginCallActive == null) {
+            throw new ValidationException("VALIDATION_ERROR", "active is required");
+        }
+        Client client = clientRepository.findById(id)
+                .orElseThrow(() -> new ClientNotFoundException("CLIENT_NOT_FOUND",
+                        "Client not found: " + id));
+
+        if (marginCallActive.equals(client.getMarginCallActive())) {
+            log.debug("Margin call flag unchanged: clientId={} marginCallActive={}", id, marginCallActive);
+            return clientMapper.toProfileResponse(client);
+        }
+
+        client.setMarginCallActive(marginCallActive);
+        clientRepository.save(client);
+        evictPortfolioCache(id);
+
+        log.info("Margin call flag updated: clientId={} marginCallActive={}", id, marginCallActive);
+        return clientMapper.toProfileResponse(client);
+    }
