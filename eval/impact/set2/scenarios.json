  {
    "id": "H05",
    "title": "Audit service subscribes to risk.evaluation.result to log risk decisions",
    "unit": "audit-service",
    "edits": [
      {
        "file": "services/audit-service/src/main/java/com/brokerdealer/auditservice/kafka/consumer/AuditEventConsumer.java",
        "find": "    private UUID parseUuid(Object value) {",
        "replace": "    @KafkaListener(topics = \"risk.evaluation.result\",\n                   groupId = \"audit-service-risk.evaluation.result-group\")\n    public void consumeRiskResult(Map<String, Object> event) {\n        UUID orderId = parseUuid(event.get(\"orderId\"));\n        if (orderId == null) {\n            return;\n        }\n        AuditLog auditLog = AuditLog.builder()\n                .entityType(\"RISK\")\n                .entityId(orderId)\n                .clientId(parseUuid(event.get(\"clientId\")))\n                .newState(String.valueOf(event.get(\"result\")))\n                .actorType(ActorType.SYSTEM)\n                .eventTimestamp(Instant.now())\n                .metadata(toJson(Map.of(\"violatedRuleCode\", String.valueOf(event.get(\"violatedRuleCode\")))))\n                .build();\n        auditLogRepository.save(auditLog);\n    }\n\n    private UUID parseUuid(Object value) {"
      }
    ],
    "kind": "kafka-consumer"
  },
