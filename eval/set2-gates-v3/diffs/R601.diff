+package com.brokerdealer.orderservice.exception;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class MaxOpenOrdersExceededExceptionTest {
+
+    @Test
+    void shouldCarryErrorCodeAndMapAsSemanticValidation() {
+        MaxOpenOrdersExceededException ex = new MaxOpenOrdersExceededException(10, 10);
+
+        assertThat(ex).isInstanceOf(SemanticValidationException.class);
+        assertThat(ex.getErrorCode()).isEqualTo("MAX_OPEN_ORDERS_EXCEEDED");
+        assertThat(ex.getMessage()).contains("10 open orders");
+    }
+}
