+package com.brokerdealer.marketdataservice.service;
+
+import com.brokerdealer.marketdataservice.domain.MarketHoliday;
+import com.brokerdealer.marketdataservice.dto.response.MarketHolidayResponse;
+import com.brokerdealer.marketdataservice.mapper.MarketHolidayMapper;
+import com.brokerdealer.marketdataservice.repository.MarketHolidayRepository;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.time.LocalDate;
+import java.util.Optional;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class MarketHolidayLookupTest {
+
+    @Mock private MarketHolidayRepository marketHolidayRepository;
+    @Mock private MarketHolidayMapper marketHolidayMapper;
+    @InjectMocks private MarketDataService marketDataService;
+
+    @Test
+    void shouldReturnHolidayWhenDateIsHoliday() {
+        LocalDate thanksgiving = LocalDate.of(2026, 11, 26);
+        MarketHoliday holiday = MarketHoliday.builder().holidayDate(thanksgiving).holidayName("Thanksgiving").build();
+        when(marketHolidayRepository.findById(thanksgiving)).thenReturn(Optional.of(holiday));
+        when(marketHolidayMapper.toResponse(holiday)).thenReturn(
+                MarketHolidayResponse.builder().holidayDate("2026-11-26").holidayName("Thanksgiving").build());
+
+        assertThat(marketDataService.getHoliday(thanksgiving).getHolidayName()).isEqualTo("Thanksgiving");
+    }
+}
