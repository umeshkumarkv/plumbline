+package com.brokerdealer.executionservice.service;
+
+import org.junit.jupiter.api.Test;
+
+import java.time.Instant;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class MarketSessionGuardTest {
+
+    private final MarketSessionGuard guard = new MarketSessionGuard();
+
+    @Test
+    void shouldBeOpenMidSession() {
+        assertThat(guard.isRegularSession(Instant.parse("2026-10-13T14:00:00Z"))).isTrue();
+    }
+
+    @Test
+    void shouldBeClosedBeforeOpen() {
+        assertThat(guard.isRegularSession(Instant.parse("2026-10-13T08:00:00Z"))).isFalse();
+    }
+
+    @Test
+    void shouldBeClosedOnWeekend() {
+        assertThat(guard.isRegularSession(Instant.parse("2026-10-17T15:00:00Z"))).isFalse();
+    }
+}
