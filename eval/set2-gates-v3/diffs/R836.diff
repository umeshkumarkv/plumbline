+package com.brokerdealer.executionservice.service;
+
+import org.springframework.stereotype.Component;
+
+import java.time.DayOfWeek;
+import java.time.Instant;
+import java.time.LocalTime;
+import java.time.ZoneOffset;
+import java.time.ZonedDateTime;
+
+/**
+ * Regular trading session guard for the LIMIT order price monitor.
+ * Pre- and post-market trading are out of scope for the POC (CLAUDE.md §18).
+ */
+@Component
+public class MarketSessionGuard {
+
+    static final LocalTime SESSION_OPEN = LocalTime.of(9, 30);
+    static final LocalTime SESSION_CLOSE = LocalTime.of(16, 0);
+
+    public boolean isRegularSession() {
+        return isRegularSession(Instant.now());
+    }
+
+    boolean isRegularSession(Instant instant) {
+        ZonedDateTime now = instant.atZone(ZoneOffset.UTC);
+        DayOfWeek day = now.getDayOfWeek();
+        if (day == DayOfWeek.SATURDAY || day == DayOfWeek.SUNDAY) {
+            return false;
+        }
+        LocalTime time = now.toLocalTime();
+        return !time.isBefore(SESSION_OPEN) && time.isBefore(SESSION_CLOSE);
+    }
+}
