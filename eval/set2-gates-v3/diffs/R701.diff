+    /**
+     * Moves shares of one symbol from a source account to a target account at the
+     * source's average cost (operations journal). Cash balances are not affected.
+     */
+    public Map<String, Object> journalPosition(UUID sourceClientId, UUID targetClientId,
+                                               String symbol, Integer quantity) {
+        if (symbol == null || !symbol.matches("[A-Z]{1,6}")) {
+            throw new ValidationException("VALIDATION_ERROR", "symbol must be 1-6 uppercase letters");
+        }
+        if (quantity == null || quantity <= 0) {
+            throw new ValidationException("VALIDATION_ERROR", "quantity must be greater than 0");
+        }
+        if (sourceClientId.equals(targetClientId)) {
+            throw new ValidationException("INVALID_JOURNAL", "source and target client must differ");
+        }
+        if (!clientRepository.existsById(sourceClientId) || !clientRepository.existsById(targetClientId)) {
+            throw new ClientNotFoundException("CLIENT_NOT_FOUND", "Source or target client not found");
+        }
+
+        Holding source = holdingRepository.findByClientIdAndSymbol(sourceClientId, symbol)
+                .orElseThrow(() -> new ValidationException("INSUFFICIENT_HOLDINGS",
+                        "No position in " + symbol + " to journal"));
+        if (source.getQuantity() < quantity) {
+            throw new ValidationException("INSUFFICIENT_HOLDINGS",
+                    "Journal quantity exceeds position in " + symbol);
+        }
+
+        source.setQuantity(source.getQuantity() - quantity);
+        holdingRepository.save(source);
+        upsertHolding(targetClientId, symbol, quantity, source.getAvgPrice());
+
+        evictPortfolioCache(sourceClientId);
+        evictPortfolioCache(targetClientId);
+        log.info("Position journal applied: sourceClientId={} targetClientId={} symbol={} qty={}",
+                sourceClientId, targetClientId, symbol, quantity);
+
+        return Map.of("sourceClientId", sourceClientId, "targetClientId", targetClientId,
+                "symbol", symbol, "quantity", quantity);
+    }
