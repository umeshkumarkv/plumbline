+    public AuditTrailResponse getAuditTrail(UUID clientId, String from, String to, int page, int size) {
+        if ((from == null || from.isBlank()) && (to == null || to.isBlank())) {
+            return getAuditTrail(clientId, page, size);
+        }
+        Instant fromTs = parseBound(from, Instant.EPOCH, "from");
+        Instant toTs = parseBound(to, Instant.now(), "to");
+        if (fromTs.isAfter(toTs)) {
+            throw new ValidationException("VALIDATION_ERROR", "from must not be after to");
+        }
+        PageRequest pageRequest = PageRequest.of(Math.max(page, 0), Math.min(Math.max(size, 1), 100));
+
+        Page<AuditLog> auditPage = clientId != null
+                ? auditLogRepository.findByClientIdAndEventTimestampBetweenOrderByEventTimestampDesc(
+                        clientId, fromTs, toTs, pageRequest)
+                : auditLogRepository.findByEventTimestampBetweenOrderByEventTimestampDesc(fromTs, toTs, pageRequest);
+
+        log.debug("getAuditTrail window: clientId={} from={} to={} total={}",
+                clientId, fromTs, toTs, auditPage.getTotalElements());
+
+        return AuditTrailResponse.builder()
+                .data(AuditTrailData.builder()
+                        .records(auditPage.getContent().stream().map(this::toResponse).toList())
+                        .totalElements(auditPage.getTotalElements())
+                        .build())
+                .meta(ResponseMeta.builder()
+                        .timestamp(Instant.now().toString())
+                        .requestId(UUID.randomUUID().toString())
+                        .build())
+                .build();
+    }
+
+    private Instant parseBound(String value, Instant defaultValue, String name) {
+        if (value == null || value.isBlank()) {
+            return defaultValue;
+        }
+        try {
+            return Instant.parse(value);
+        } catch (java.time.format.DateTimeParseException e) {
+            throw new ValidationException("VALIDATION_ERROR",
+                    name + " must be ISO 8601 UTC (e.g. 2026-05-18T00:00:00Z)");
+        }
+    }
