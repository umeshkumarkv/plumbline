+package com.brokerdealer.orderservice.service;
+
+import com.brokerdealer.orderservice.domain.OrderStatus;
+import com.brokerdealer.orderservice.repository.OrderRepository;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Component;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.List;
+import java.util.UUID;
+
+/**
+ * Level 2 check #13 helper: available cash for a new BUY order, combining the settled
+ * cash balance from client-service with this service's view of in-flight orders.
+ */
+@Component
+@RequiredArgsConstructor
+@Slf4j
+public class BuyingPowerCalculator {
+
+    private final OrderRepository orderRepository;
+
+    public BigDecimal availableCash(UUID clientId, BigDecimal settledCash, List<OrderStatus> openStatuses) {
+        BigDecimal committedBuy = orderRepository.sumOpenBuyOrderValues(clientId, openStatuses);
+        BigDecimal pendingSellProceeds = orderRepository.sumOpenSellOrderValues(clientId, openStatuses);
+        BigDecimal available = combine(settledCash,
+                committedBuy != null ? committedBuy : BigDecimal.ZERO,
+                pendingSellProceeds != null ? pendingSellProceeds : BigDecimal.ZERO);
+        log.debug("Buying power computed: clientId={}", clientId);
+        return available;
+    }
+
+    static BigDecimal combine(BigDecimal settledCash, BigDecimal committedBuy, BigDecimal pendingSellProceeds) {
+        return settledCash
+                .subtract(committedBuy)
+                .add(pendingSellProceeds)
+                .setScale(2, RoundingMode.HALF_UP);
+    }
+}
