+package com.brokerdealer.clientservice.service;
+
+import com.brokerdealer.clientservice.client.MarketDataClient;
+import com.brokerdealer.clientservice.domain.Client;
+import com.brokerdealer.clientservice.domain.Holding;
+import com.brokerdealer.clientservice.dto.response.PortfolioResponse;
+import com.brokerdealer.clientservice.repository.ClientRepository;
+import com.brokerdealer.clientservice.repository.HoldingRepository;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class PortfolioTotalsTest {
+
+    @Mock private ClientRepository clientRepository;
+    @Mock private HoldingRepository holdingRepository;
+    @Mock private MarketDataClient marketDataClient;
+    @InjectMocks private ClientService clientService;
+
+    @Test
+    void shouldSumMarketValueAcrossPricedHoldings() {
+        UUID clientId = UUID.randomUUID();
+        when(clientRepository.findById(clientId)).thenReturn(Optional.of(Client.builder()
+                .id(clientId).name("Test Client").cashBalance(new BigDecimal("1000.00")).build()));
+        when(holdingRepository.findByClientId(clientId)).thenReturn(List.of(
+                Holding.builder().clientId(clientId).symbol("AAPL").quantity(10).avgPrice(new BigDecimal("100.0000")).build(),
+                Holding.builder().clientId(clientId).symbol("MSFT").quantity(5).avgPrice(new BigDecimal("300.0000")).build()));
+        when(marketDataClient.getLastPrice("AAPL")).thenReturn(new BigDecimal("110.00"));
+        when(marketDataClient.getLastPrice("MSFT")).thenReturn(null);
+
+        PortfolioResponse portfolio = clientService.getPortfolio(clientId);
+
+        assertThat(portfolio.getTotalMarketValue()).isEqualTo("1100.00");
+        assertThat(portfolio.getTotalUnrealisedPnL()).isEqualTo("100.00");
+    }
+}
