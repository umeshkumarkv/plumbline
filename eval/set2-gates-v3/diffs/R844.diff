+package com.brokerdealer.clientservice.service;
+
+import com.brokerdealer.clientservice.domain.Client;
+import com.brokerdealer.clientservice.repository.ClientRepository;
+import com.brokerdealer.clientservice.repository.HoldingRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.data.redis.core.RedisTemplate;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import java.math.BigDecimal;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class CommissionApplicationTest {
+
+    @Mock private ClientRepository clientRepository;
+    @Mock private HoldingRepository holdingRepository;
+    @Mock private RedisTemplate<String, Object> redisTemplate;
+    @InjectMocks private ClientService clientService;
+
+    @BeforeEach
+    void setUp() {
+        ReflectionTestUtils.setField(clientService, "commissionRate", new BigDecimal("0.0005"));
+    }
+
+    @Test
+    void shouldDebitFillValuePlusCommissionOnBuy() {
+        UUID clientId = UUID.randomUUID();
+        Client client = Client.builder().id(clientId).cashBalance(new BigDecimal("10000.00"))
+                .turnoverToday(BigDecimal.ZERO).build();
+        when(clientRepository.findById(clientId)).thenReturn(Optional.of(client));
+        when(holdingRepository.findByClientIdAndSymbol(clientId, "AAPL")).thenReturn(Optional.empty());
+
+        clientService.processExecutionFill(Map.of("clientId", clientId.toString(), "side", "BUY",
+                "fillType", "FULL", "executedQty", 10, "executedPrice", "100.00",
+                "fillValue", "1000.00", "symbol", "AAPL"));
+
+        assertThat(client.getCashBalance()).isEqualByComparingTo("8999.50");
+    }
+}
