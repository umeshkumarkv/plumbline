+package com.brokerdealer.clientservice.service;
+
+import com.brokerdealer.clientservice.client.MarketDataClient;
+import com.brokerdealer.clientservice.domain.Holding;
+import com.brokerdealer.clientservice.dto.response.PortfolioSummaryResponse;
+import com.brokerdealer.clientservice.exception.ClientNotFoundException;
+import com.brokerdealer.clientservice.repository.ClientRepository;
+import com.brokerdealer.clientservice.repository.HoldingRepository;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class PortfolioSummaryService {
+
+    private final ClientRepository clientRepository;
+    private final HoldingRepository holdingRepository;
+
+    @Autowired
+    private MarketDataClient marketDataClient;
+
+    public PortfolioSummaryResponse getSummary(UUID clientId) {
+        log.debug("Building portfolio summary: clientId={}", clientId);
+        if (!clientRepository.existsById(clientId)) {
+            throw new ClientNotFoundException("CLIENT_NOT_FOUND", "Client not found: " + clientId);
+        }
+
+        List<Holding> holdings = holdingRepository.findByClientId(clientId).stream()
+                .filter(h -> h.getQuantity() != null && h.getQuantity() > 0)
+                .toList();
+
+        BigDecimal costBasis = BigDecimal.ZERO;
+        BigDecimal marketValue = BigDecimal.ZERO;
+        int unpriced = 0;
+        for (Holding holding : holdings) {
+            BigDecimal qty = BigDecimal.valueOf(holding.getQuantity());
+            costBasis = costBasis.add(holding.getAvgPrice().multiply(qty));
+            BigDecimal lastPrice = marketDataClient.getLastPrice(holding.getSymbol());
+            if (lastPrice == null) {
+                unpriced++;
+                continue;
+            }
+            marketValue = marketValue.add(lastPrice.multiply(qty));
+        }
+
+        return PortfolioSummaryResponse.builder()
+                .clientId(clientId)
+                .positionCount(holdings.size())
+                .totalCostBasis(costBasis.setScale(2, RoundingMode.HALF_UP).toPlainString())
+                .totalMarketValue(marketValue.setScale(2, RoundingMode.HALF_UP).toPlainString())
+                .unpricedPositions(unpriced)
+                .build();
+    }
+}
