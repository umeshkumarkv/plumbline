+    public List<HoldingDetailResponse> getHoldings(UUID id) {
+        log.debug("Fetching holdings: clientId={}", id);
+        if (!clientRepository.existsById(id)) {
+            throw new ClientNotFoundException("CLIENT_NOT_FOUND", "Client not found: " + id);
+        }
+        List<Holding> holdings = holdingRepository.findByClientId(id);
+        if (holdings.isEmpty()) {
+            return Collections.emptyList();
+        }
+        return holdings.stream()
+                .filter(h -> h.getQuantity() != null && h.getQuantity() > 0)
+                .map(this::buildHoldingDetail)
+                .toList();
+    }
