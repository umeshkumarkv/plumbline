 import java.time.Instant;
 import java.time.LocalDate;
 import java.time.ZoneId;
 import java.util.List;
 import java.util.UUID;
 
 @RestController
 @RequestMapping("/api/v1/executions")
 @RequiredArgsConstructor
 @Slf4j
 public class ExecutionController {
 
+    private static final ZoneId ET_ZONE = ZoneId.of("America/New_York");
+
     private final ExecutionService executionService;
+    private final ExecutionRepository executionRepository;
+
+    @GetMapping("/symbol/{symbol}/vwap")
+    public ResponseEntity<VwapResponse> getIntradayVwap(@PathVariable String symbol) {
+        String normalised = symbol.toUpperCase();
+        LocalDate tradeDate = LocalDate.now(ET_ZONE);
+        Instant from = tradeDate.atStartOfDay(ET_ZONE).toInstant();
+        Instant to = tradeDate.plusDays(1).atStartOfDay(ET_ZONE).toInstant();
+
+        List<Execution> fills = executionRepository.findBySymbolAndFillTypeInAndExecutedAtBetween(
+                normalised, List.of(FillType.FULL, FillType.PARTIAL), from, to);
+        if (fills.isEmpty()) {
+            throw new ResourceNotFoundException("NO_EXECUTIONS", "No executions today for symbol: " + normalised);
+        }
+
+        int totalQty = fills.stream().mapToInt(Execution::getExecutedQty).sum();
+        BigDecimal notional = fills.stream()
+                .map(e -> e.getExecutedPrice().multiply(BigDecimal.valueOf(e.getExecutedQty())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+        BigDecimal vwap = notional.divide(BigDecimal.valueOf(totalQty), 4, RoundingMode.HALF_UP);
+
+        log.debug("VWAP computed: symbol={} fills={}", normalised, fills.size());
+        return ResponseEntity.ok(VwapResponse.builder()
+                .data(VwapResponse.VwapData.builder()
+                        .symbol(normalised)
+                        .tradeDate(tradeDate.toString())
+                        .fillCount(fills.size())
+                        .totalQuantity(totalQty)
+                        .vwap(vwap.toPlainString())
+                        .build())
+                .meta(ResponseMeta.builder()
+                        .timestamp(Instant.now().toString())
+                        .requestId(UUID.randomUUID().toString())
+                        .build())
+                .build());
+    }
 
     @GetMapping("/{orderId}")
     public ResponseEntity<ExecutionListResponse> getExecutionsByOrderId(@PathVariable UUID orderId) {
         log.debug("GET /api/v1/executions/{}", orderId);
         ExecutionListResponse response = executionService.getExecutionsByOrderId(orderId);
         return ResponseEntity.ok(response);
     }
 }
