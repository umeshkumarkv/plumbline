+package com.brokerdealer.orderservice.service;
+
+import org.junit.jupiter.api.Test;
+
+import java.time.Instant;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TradingDayCalendarTest {
+
+    @Test
+    void shouldUseEasternMidnightDuringDaylightTime() {
+        // 2026-10-13 02:00Z is still 2026-10-12 in New York (EDT, UTC-4)
+        assertThat(TradingDayCalendar.startOfTradingDay(Instant.parse("2026-10-13T02:00:00Z")))
+                .isEqualTo(Instant.parse("2026-10-12T04:00:00Z"));
+    }
+
+    @Test
+    void shouldUseEasternMidnightDuringStandardTime() {
+        assertThat(TradingDayCalendar.startOfTradingDay(Instant.parse("2026-12-01T15:00:00Z")))
+                .isEqualTo(Instant.parse("2026-12-01T05:00:00Z"));
+    }
+}
