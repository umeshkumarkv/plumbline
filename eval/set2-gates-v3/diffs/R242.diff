+package com.brokerdealer.orderservice.service;
+
+import org.springframework.stereotype.Component;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+
+/**
+ * Trading-day boundaries in America/New_York (CLAUDE.md §10 — never UTC for market time).
+ */
+@Component
+public class TradingDayCalendar {
+
+    static final ZoneId ET_ZONE = ZoneId.of("America/New_York");
+
+    private final Clock clock;
+
+    public TradingDayCalendar(Clock clock) {
+        this.clock = clock;
+    }
+
+    public Instant startOfTradingDay() {
+        return startOfTradingDay(Instant.now(clock));
+    }
+
+    static Instant startOfTradingDay(Instant now) {
+        LocalDate tradeDate = now.atZone(ET_ZONE).toLocalDate();
+        return tradeDate.atStartOfDay(ET_ZONE).toInstant();
+    }
+}
