+package com.brokerdealer.orderservice.service;
+
+import com.brokerdealer.orderservice.domain.Order;
+import com.brokerdealer.orderservice.domain.OrderSide;
+import com.brokerdealer.orderservice.domain.OrderStatus;
+import com.brokerdealer.orderservice.repository.OrderRepository;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Component;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+/**
+ * Level 2 check #12: detects an open order from the same client on the opposite side
+ * of the book that the new order would trade against.
+ * SELL and SHORT_SELL are both treated as the sell side of the book.
+ */
+@Component
+@RequiredArgsConstructor
+@Slf4j
+public class SelfTradeDetector {
+
+    private static final List<OrderSide> SELL_SIDES = List.of(OrderSide.SELL, OrderSide.SHORT_SELL);
+    private static final List<OrderSide> BUY_SIDES = List.of(OrderSide.BUY);
+
+    private final OrderRepository orderRepository;
+
+    public boolean hasCrossingOpenOrder(UUID clientId, String symbol, OrderSide side,
+                                        BigDecimal limitPrice, List<OrderStatus> openStatuses) {
+        List<OrderSide> oppositeSides = side == OrderSide.BUY ? SELL_SIDES : BUY_SIDES;
+        List<Order> opposite = orderRepository.findByClientIdAndSymbolAndSideInAndStatusIn(
+                clientId, symbol, oppositeSides, openStatuses);
+        boolean crossing = opposite.stream().anyMatch(o -> crosses(side, limitPrice, o.getLimitPrice()));
+        if (crossing) {
+            log.debug("Crossing open order detected: clientId={} symbol={} side={}", clientId, symbol, side);
+        }
+        return crossing;
+    }
+
+    static boolean crosses(OrderSide side, BigDecimal newLimit, BigDecimal restingLimit) {
+        if (newLimit == null || restingLimit == null) {
+            return true;
+        }
+        return side == OrderSide.BUY
+                ? restingLimit.compareTo(newLimit) >= 0
+                : restingLimit.compareTo(newLimit) <= 0;
+    }
+}
