+    /**
+     * Estimated commission at order entry: basis points on notional, bounded by the
+     * per-order minimum and maximum. Kept at 4dp like other monetary order columns.
+     */
+    private BigDecimal estimateCommission(BigDecimal orderValue) {
+        if (orderValue == null || orderValue.signum() <= 0) {
+            return commissionMinimum.setScale(4, RoundingMode.HALF_UP);
+        }
+        BigDecimal commission = orderValue
+                .multiply(commissionRateBps)
+                .divide(BigDecimal.valueOf(10_000), 4, RoundingMode.HALF_UP);
+        if (commission.compareTo(commissionMinimum) < 0) {
+            return commissionMinimum.setScale(4, RoundingMode.HALF_UP);
+        }
+        if (commission.compareTo(commissionMaximum) > 0) {
+            return commissionMaximum.setScale(4, RoundingMode.HALF_UP);
+        }
+        return commission;
+    }
