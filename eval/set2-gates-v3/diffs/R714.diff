+package com.brokerdealer.riskservice.rule;
+
+import com.brokerdealer.riskservice.domain.RiskResult;
+import com.brokerdealer.riskservice.domain.RiskRule;
+import com.brokerdealer.riskservice.dto.RiskContext;
+import com.brokerdealer.riskservice.dto.RiskEvaluationRequest;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+
+/**
+ * Hard collar for LIMIT orders: REJECT when |limitPrice - lastPrice| / lastPrice exceeds
+ * the configured threshold. MARKET orders and orders without a reference price are skipped.
+ */
+@RequiredArgsConstructor
+@Slf4j
+public class LimitPriceCollarRule implements RiskRule {
+
+    private final BigDecimal threshold;
+    private final boolean enabled;
+
+    @Override
+    public String getRuleCode() {
+        return "LIMIT_PRICE_COLLAR";
+    }
+
+    @Override
+    public boolean isEnabled() {
+        return enabled;
+    }
+
+    @Override
+    public RiskResult evaluate(RiskEvaluationRequest request, RiskContext context) {
+        if (!"LIMIT".equals(request.getOrderType())
+                || request.getLimitPrice() == null || request.getLastPrice() == null || threshold == null) {
+            return RiskResult.passed();
+        }
+        BigDecimal limitPrice = new BigDecimal(request.getLimitPrice());
+        BigDecimal lastPrice = new BigDecimal(request.getLastPrice());
+        if (lastPrice.signum() <= 0) {
+            log.debug("LIMIT_PRICE_COLLAR skipped: non-positive lastPrice; orderId={}", context.getOrderId());
+            return RiskResult.passed();
+        }
+
+        BigDecimal deviation = limitPrice.subtract(lastPrice).abs()
+                .divide(lastPrice, 10, RoundingMode.HALF_UP);
+        if (deviation.compareTo(threshold) > 0) {
+            return RiskResult.rejected(getRuleCode(),
+                    "LIMIT_PRICE_COLLAR: limitPrice deviates "
+                            + deviation.multiply(BigDecimal.valueOf(100)).setScale(2, RoundingMode.HALF_UP)
+                            + "% from lastPrice");
+        }
+        return RiskResult.passed();
+    }
+}
