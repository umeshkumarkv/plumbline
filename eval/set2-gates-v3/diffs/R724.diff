+package com.brokerdealer.orderservice.service;
+
+import com.brokerdealer.orderservice.domain.Order;
+import com.brokerdealer.orderservice.domain.OrderSide;
+import com.brokerdealer.orderservice.domain.OrderStatus;
+import com.brokerdealer.orderservice.dto.response.OpenExposureResponse;
+import com.brokerdealer.orderservice.dto.response.ResponseMeta;
+import com.brokerdealer.orderservice.repository.OrderRepository;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+@RequiredArgsConstructor
+@Slf4j
+public class OpenExposureService {
+
+    private static final List<OrderStatus> OPEN_STATUSES = List.of(
+            OrderStatus.NEW, OrderStatus.VALIDATED, OrderStatus.RISK_CHECK_PASSED,
+            OrderStatus.ACCEPTED, OrderStatus.SENT_TO_EXECUTION, OrderStatus.PARTIALLY_FILLED);
+
+    private final OrderRepository orderRepository;
+
+    public OpenExposureResponse getOpenExposure(UUID clientId) {
+        log.debug("Computing open exposure: clientId={}", clientId);
+        List<Order> openOrders = orderRepository.findAll((root, query, cb) -> cb.and(
+                cb.equal(root.get("clientId"), clientId),
+                root.get("status").in(OPEN_STATUSES)));
+
+        long buyCents = 0L;
+        long sellCents = 0L;
+        int buyCount = 0;
+        int sellCount = 0;
+        for (Order order : openOrders) {
+            if (order.getOrderValue() == null) {
+                continue;
+            }
+            long cents = order.getOrderValue().movePointRight(2)
+                    .setScale(0, RoundingMode.HALF_UP)
+                    .longValueExact();
+            if (order.getSide() == OrderSide.BUY) {
+                buyCents += cents;
+                buyCount++;
+            } else {
+                sellCents += cents;
+                sellCount++;
+            }
+        }
+
+        BigDecimal buyNotional = BigDecimal.valueOf(buyCents / 100.0).setScale(2, RoundingMode.HALF_UP);
+        BigDecimal sellNotional = BigDecimal.valueOf(sellCents / 100.0).setScale(2, RoundingMode.HALF_UP);
+        BigDecimal netNotional = buyNotional.subtract(sellNotional);
+
+        return OpenExposureResponse.builder()
+                .data(OpenExposureResponse.OpenExposureData.builder()
+                        .clientId(clientId)
+                        .openBuyCount(buyCount)
+                        .openSellCount(sellCount)
+                        .openBuyNotional(buyNotional.toPlainString())
+                        .openSellNotional(sellNotional.toPlainString())
+                        .netNotional(netNotional.toPlainString())
+                        .build())
+                .meta(ResponseMeta.builder()
+                        .timestamp(Instant.now().toString())
+                        .requestId(UUID.randomUUID().toString())
+                        .build())
+                .build();
+    }
+}
